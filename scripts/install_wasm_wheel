#!/usr/bin/env python3

import argparse
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zipfile
from importlib.machinery import SourceFileLoader
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
WASM_DIR = ROOT_DIR / "wasm"
PYPROJECT_PATH = ROOT_DIR / "python" / "pyproject.toml"
WHEEL_PATH_PATTERN = re.compile(r'(?m)^(const PYXEL_WHEEL_PATH\s*=\s*")[^"]+(";)$')
REPOSITORY = "kitao/pyxel"
WORKFLOW = ".github/workflows/build-wasm.yml"


def main(run_id) -> int:
    try:
        if not re.fullmatch(r"[1-9][0-9]*", run_id):
            raise ValueError("supply the numeric ID of a successful build-wasm run")
        with tempfile.TemporaryDirectory() as directory:
            artifact_dir = Path(directory)
            download_release_wheel(run_id, artifact_dir)
            return install_wheel(artifact_dir)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print(
            f"error: could not install the GitHub Actions wheel: {error}",
            file=sys.stderr,
        )
        return 1


def github(*args):
    return subprocess.check_output(
        ["gh", *args], env={**os.environ, "GH_HOST": "github.com"}, encoding="utf-8"
    )


def download_release_wheel(run_id, directory):
    git_env = {k: v for k, v in os.environ.items() if not k.upper().startswith("GIT_")}
    git = ["git", "-C", str(ROOT_DIR)]
    if subprocess.check_output(
        [*git, "status", "--porcelain", "--untracked-files=all"], env=git_env
    ):
        raise ValueError("the release wheel requires a clean source checkout")
    commit = subprocess.check_output(
        [*git, "rev-parse", "HEAD"], env=git_env, text=True
    ).strip()
    run = json.loads(github("api", f"repos/{REPOSITORY}/actions/runs/{run_id}"))
    if not (
        run["path"] == WORKFLOW
        and run["event"] == "workflow_dispatch"
        and run["status"] == "completed"
        and run["conclusion"] == "success"
        and run["head_sha"] == commit
        and (run.get("head_repository") or {}).get("full_name") == REPOSITORY
    ):
        raise ValueError(
            f"run {run_id} is not a successful {WORKFLOW} build of {commit}"
        )
    github(
        "run",
        "download",
        run_id,
        "--repo",
        REPOSITORY,
        "--name",
        "pyxel-wasm",
        "--dir",
        str(directory),
    )
    files = list(directory.iterdir())
    if len(files) != 1 or files[0].suffix != ".whl" or not files[0].is_file():
        raise ValueError("the pyxel-wasm artifact must contain exactly one wheel")
    github(
        "attestation",
        "verify",
        str(files[0]),
        "--repo",
        REPOSITORY,
        "--signer-workflow",
        f"{REPOSITORY}/{WORKFLOW}",
        "--source-digest",
        commit,
        "--deny-self-hosted-runners",
    )


def install_wheel(directory):
    try:
        checker_path = Path(__file__).with_name("check_wasm_wheel")
        loader = SourceFileLoader("_pyxel_wheel_checker", str(checker_path))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        checker = importlib.util.module_from_spec(spec)
        loader.exec_module(checker)
        wheel_path = checker.find_wheel(directory, PYPROJECT_PATH)
        violations = checker.find_release_violations(wheel_path, ROOT_DIR)
        if violations:
            raise ValueError(f"wheel contents failed validation: {violations}")
    except (OSError, UnicodeDecodeError, ValueError, zipfile.BadZipFile) as error:
        print(f"error: invalid WebAssembly wheel: {error}", file=sys.stderr)
        return 1

    WASM_DIR.mkdir(parents=True, exist_ok=True)
    script_path = WASM_DIR / "pyxel.js"
    script = script_path.read_text(encoding="utf-8")
    updated_script, count = WHEEL_PATH_PATTERN.subn(
        lambda match: f"{match.group(1)}{wheel_path.name}{match.group(2)}",
        script,
        count=1,
    )
    if count != 1:
        print(f"error: wheel path pattern not found in {script_path}", file=sys.stderr)
        return 1

    installed_wheel_path = WASM_DIR / wheel_path.name
    wheel_temp_path = installed_wheel_path.with_name(f".{wheel_path.name}.tmp")
    script_temp_path = script_path.with_suffix(".js.tmp")
    try:
        shutil.copy2(wheel_path, wheel_temp_path)
        script_temp_path.write_text(updated_script, encoding="utf-8")
        wheel_temp_path.replace(installed_wheel_path)
        script_temp_path.replace(script_path)
    finally:
        wheel_temp_path.unlink(missing_ok=True)
        script_temp_path.unlink(missing_ok=True)

    for pattern in checker.WASM_WHEEL_GLOBS:
        for old_wheel_path in WASM_DIR.glob(pattern):
            if old_wheel_path != installed_wheel_path:
                old_wheel_path.unlink()
    return 0


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Install the validated Pyxel WebAssembly wheel."
    )
    parser.add_argument(
        "--github-run",
        metavar="RUN_ID",
        required=True,
        help="install the official build of the current commit",
    )
    raise SystemExit(main(parser.parse_args().github_run))
