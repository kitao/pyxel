#!/usr/bin/env python3

import argparse
import io
import json
import os
import re
import runpy
import shutil
import subprocess
import sys
import tarfile
import tempfile
import zipfile
from html.parser import HTMLParser
from pathlib import Path, PurePosixPath
from urllib.parse import unquote, urlsplit

ROOT_DIR = Path(__file__).resolve().parent.parent
PAGE_DIRS = (
    "api-reference",
    "code-maker",
    "editor-manual",
    "launcher",
    "mml-studio",
    "showcase",
    "user-guide",
    "web-usage",
)
SITE_URL = "https://kitao.dev/pyxel"
CDN_URL = "https://cdn.jsdelivr.net/gh/kitao/pyxel"
PROVISIONAL_VERSION = "3.0.0"


class LocalLinks(HTMLParser):
    def __init__(self):
        super().__init__()
        self.links = []

    def handle_starttag(self, tag, attrs):
        self.links.extend(
            value for name, value in attrs if name in {"src", "href", "root"} and value
        )


def main():
    parser = argparse.ArgumentParser(
        description="Build dist/site/ for kitao.dev/pyxel without deploying.",
        epilog=(
            "Requires Node.js and npm ci --prefix web. The optional gallery uses "
            "the Python dependencies from pyxel-user-examples/requirements.txt. "
            "Preview with: python3 -m http.server --directory dist/site"
        ),
    )
    parser.add_argument(
        "--runtime-tag",
        action="append",
        help="local release tag; repeat to include more (default: v2.9.9)",
    )
    parser.add_argument("--output", type=Path, default=ROOT_DIR / "dist" / "site")
    parser.add_argument(
        "--user-examples",
        type=Path,
        help="include the gallery from this local repository",
    )
    args = parser.parse_args()
    try:
        build_site(args.output, args.runtime_tag or ["v2.9.9"], args.user_examples)
    except (
        OSError,
        ValueError,
        KeyError,
        subprocess.CalledProcessError,
        zipfile.BadZipFile,
    ) as error:
        parser.exit(1, f"error: {error}\n")
    print(f"Built {args.output.resolve()}/pyxel/.")


def build_site(output, runtime_tags=("v2.9.9",), user_examples=None, root=ROOT_DIR):
    root, output = root.resolve(), output.resolve()
    if output == root or root.is_relative_to(output):
        raise ValueError("The output must not replace the repository or its parents")
    if output.is_relative_to(root) and output != root / "dist" / "site":
        raise ValueError("Build output inside the repository must be dist/site/")
    if user_examples and (
        user_examples.resolve().is_relative_to(output)
        or output.is_relative_to(user_examples.resolve())
    ):
        raise ValueError("The output must not replace the gallery repository")

    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".site-", dir=output.parent) as temporary:
        stage = Path(temporary) / "site"
        site = stage / "pyxel"
        site.mkdir(parents=True)
        versions = [copy_release(root, tag, site) for tag in runtime_tags]
        version = versions[-1]
        copy_runtime(
            {
                path.relative_to(root / "wasm").as_posix(): path.read_bytes()
                for path in tracked_files(root, "wasm")
            },
            site / PROVISIONAL_VERSION,
            PROVISIONAL_VERSION,
        )

        for name in PAGE_DIRS:
            for source in tracked_files(root, "web/" + name):
                target = site / source.relative_to(root / "web")
                copy_page(source, target, version)
        copy_page(root / "web" / "shared.js", site / "shared.js", version)
        copy_page(root / "web" / "index.html", site / "index.html", version)
        for source_dir, target_dir in (
            ("docs/images", "assets/images"),
            ("python/pyxel/examples", "assets/examples"),
        ):
            for source in tracked_files(root, source_dir):
                target = site / target_dir / source.relative_to(root / source_dir)
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(source, target)
        shutil.copyfile(root / "docs/pyxel.gpl", site / "assets/pyxel.gpl")

        subprocess.run(
            [
                "node",
                str(root / "web/node_modules/@tailwindcss/cli/dist/index.mjs"),
                "-i",
                "styles/input.css",
                "-o",
                str(site / "styles.css"),
                "--minify",
            ],
            cwd=root / "web",
            check=True,
        )
        if user_examples:
            copy_gallery(user_examples.resolve(), site / "user-examples", version)
        (stage / "_headers").write_text(
            "/pyxel/*\n"
            "  X-Content-Type-Options: nosniff\n"
            "  Referrer-Policy: strict-origin-when-cross-origin\n\n"
            + "".join(
                f"/pyxel/{release}/*\n"
                "  Cache-Control: public, max-age=31536000, immutable\n"
                "  Access-Control-Allow-Origin: *\n\n"
                for release in versions
                if release != PROVISIONAL_VERSION
            )
            + f"/pyxel/{PROVISIONAL_VERSION}/*\n"
            "  Cache-Control: public, max-age=0, must-revalidate\n"
            "  Access-Control-Allow-Origin: *\n\n"
            "/pyxel/assets/examples/*\n"
            "  Access-Control-Allow-Origin: *\n",
            encoding="utf-8",
        )
        verify_links(stage)
        verify_releases(stage, output)
        replace_output(stage, output)


def tracked_files(root, directory):
    names = (
        subprocess.check_output(
            ["git", "-C", str(root), "ls-files", "-z", "--", directory]
        )
        .decode()
        .split("\0")
    )
    for name in names:
        if not name or any(
            part.startswith(".") or part == "__pycache__" for part in Path(name).parts
        ):
            continue
        path = root / name
        if path.is_symlink() or not path.resolve().is_relative_to(
            (root / directory).resolve()
        ):
            raise ValueError(f"Public source must stay inside {directory}: {name}")
        if path.is_file() and path.suffix not in {".pyc", ".pyo"}:
            yield path


def copy_release(root, tag, site):
    if not re.fullmatch(r"v\d+\.\d+\.\d+(?:(?:a|b|rc)\d+)?", tag):
        raise ValueError("The runtime tag must be a release tag such as v2.9.9")
    env = {**os.environ, "GIT_NO_LAZY_FETCH": "1"}
    commit = (
        subprocess.check_output(
            [
                "git",
                "-C",
                str(root),
                "rev-parse",
                "--verify",
                f"refs/tags/{tag}^{{commit}}",
            ],
            env=env,
        )
        .decode()
        .strip()
    )
    archive = subprocess.check_output(
        ["git", "-C", str(root), "archive", "--format=tar", commit, "wasm"],
        env=env,
    )
    with tarfile.open(fileobj=io.BytesIO(archive)) as contents:
        files = {
            PurePosixPath(item.name)
            .relative_to("wasm")
            .as_posix(): contents.extractfile(item).read()
            for item in contents.getmembers()
            if item.isfile()
        }
    version = tag[1:]
    copy_runtime(files, site / version, version)
    return version


def copy_runtime(files, target, version=None):
    script = files["pyxel.js"].decode("utf-8")
    match = re.search(r'const PYXEL_WHEEL_PATH\s*=\s*"([^"/]+\.whl)";', script)
    if not match:
        raise ValueError("The runtime does not identify a Web wheel")
    wheel = match[1]
    with zipfile.ZipFile(io.BytesIO(files[wheel])) as contents:
        if contents.testzip():
            raise ValueError(f"Corrupt Web wheel: {wheel}")
        if version:
            metadata = contents.read(f"pyxel-{version}.dist-info/METADATA").decode(
                "utf-8"
            )
            if f"\nVersion: {version}\n" not in metadata:
                raise ValueError(f"The Web wheel does not match version {version}")
    names = {"pyxel.js", "pyxel.css", "import_hook.py", wheel}
    names.update(re.findall(r'const \w+_PATH\s*=\s*"([^"\n]+)";', script))
    names.update(name for name in files if name.startswith("images/"))
    for name in sorted(names):
        path = target / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(files[name])


def copy_page(source, target, version):
    target.parent.mkdir(parents=True, exist_ok=True)
    if source.suffix in {".html", ".js", ".json", ".css"}:
        text = rewrite_urls(
            source.read_text(encoding="utf-8"), version, source.suffix == ".html"
        )
        target.write_text(text, encoding="utf-8")
    else:
        shutil.copyfile(source, target)


def rewrite_urls(text, version, html=False):
    runtime_url = f"{SITE_URL}/{version}/pyxel.js"
    text = text.replace(f"{CDN_URL}/wasm/pyxel.js", runtime_url)
    text = text.replace(f"{CDN_URL}@v{version}/wasm/pyxel.js", runtime_url)
    if html:
        text = re.sub(r"""(["'])pyxel-(screen|editor)\.html\1""", r"\1pyxel-\2\1", text)
        head, separator, body = text.partition("</head>")
        if separator:
            head = head.replace(runtime_url, f"/pyxel/{PROVISIONAL_VERSION}/pyxel.js")
            text = head + separator + body
    for source, target in (
        ("wasm/", f"{PROVISIONAL_VERSION}/"),
        ("docs/images/", "assets/images/"),
        ("docs/pyxel.gpl", "assets/pyxel.gpl"),
    ):
        text = re.sub(r"(?:\.\./)+" + re.escape(source), "/pyxel/" + target, text)
    text = re.sub(
        r"(?:\.\./)+python/pyxel/examples(?=/|[\"'\s<>]|$)",
        "/pyxel/assets/examples",
        text,
    )
    for source, target in (
        ("https://kitao.github.io/pyxel-user-examples", SITE_URL + "/user-examples"),
        ("https://kitao.github.io/pyxel/web", SITE_URL),
        ("https://kitao.github.io/pyxel/docs/images", SITE_URL + "/assets/images"),
        (CDN_URL + "/python/pyxel/examples", SITE_URL + "/assets/examples"),
    ):
        text = text.replace(source, target)
    return text


def copy_gallery(source, target, version):
    # Render through the gallery's owner without changing its checkout or generated pages.
    sys.path.insert(0, str(source / "scripts"))
    try:
        builder = runpy.run_path(str(source / "scripts" / "build_pages"))
        pages = builder["render_pages"](source)
    except ImportError as error:
        raise ValueError(
            "Install the gallery's requirements.txt into the active Python environment"
        ) from error
    finally:
        sys.path.pop(0)
    for path, text in pages.items():
        destination = target / path.relative_to(source)
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(rewrite_urls(text, version), encoding="utf-8")
    for name in ("styles.css", "lightbox.js", "favicon.ico"):
        shutil.copyfile(source / name, target / name)
    for image in sorted(
        {
            url
            for text in pages.values()
            for url in re.findall(r"images/(\d+\.gif)", text)
        }
    ):
        destination = target / "images" / image
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source / "images" / image, destination)


def verify_links(stage):
    errors = []
    for path in stage.rglob("*"):
        if path.suffix not in {".html", ".json"}:
            continue
        parser = LocalLinks()
        text = path.read_text(encoding="utf-8")
        if path.suffix == ".json":
            for value in text_values(json.loads(text)):
                parser.feed(value)
                parser.close()
                parser.reset()
        else:
            parser.feed(text)
        parser.links.extend(
            re.findall(r"""["'`]((?:/pyxel/|(?:\.\./)+)[^"'`<>\s\\]*)["'`]""", text)
        )
        for link in parser.links:
            url = urlsplit(link)
            if url.scheme or url.netloc or not url.path or "${" in link:
                continue
            base = stage if url.path.startswith("/") else path.parent
            target = (base / unquote(url.path).lstrip("/")).resolve()
            if not target.exists() and not target.suffix:
                target = target.with_suffix(".html")
            if not target.is_relative_to(stage.resolve()) or not target.exists():
                errors.append(f"{path.relative_to(stage)}: {link}")
    if errors:
        raise ValueError("Unresolved local links:\n" + "\n".join(errors))


def text_values(value):
    if isinstance(value, str):
        yield value
    elif isinstance(value, dict):
        for item in value.values():
            yield from text_values(item)
    elif isinstance(value, list):
        for item in value:
            yield from text_values(item)


def verify_releases(stage, output):
    # Released bundles are fixed; the provisional bundle may be replaced.
    if not (output / "pyxel").is_dir():
        return
    for release in (output / "pyxel").iterdir():
        if not re.fullmatch(r"\d+\.\d+\.\d+(?:(?:a|b|rc)\d+)?", release.name):
            continue
        before = {
            path.relative_to(release): path.read_bytes()
            for path in release.rglob("*")
            if path.is_file()
        }
        target = stage / "pyxel" / release.name
        after = {
            path.relative_to(target): path.read_bytes()
            for path in target.rglob("*")
            if path.is_file()
        }
        if before != after and not (release.name == PROVISIONAL_VERSION and after):
            raise ValueError(
                f"An existing release would change or disappear: {release.name}"
            )


def replace_output(stage, output):
    previous = stage.parent / "previous"
    if output.exists():
        output.rename(previous)
    try:
        stage.rename(output)
    except OSError:
        if previous.exists():
            previous.rename(output)
        raise


if __name__ == "__main__":
    main()
