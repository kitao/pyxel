#!/usr/bin/env python3
"""Recreate the 30 Seconds of Daylight and Megaball documentation GIFs.

Run without names to regenerate both GIFs in docs/images. Use --output-dir to
review candidates without changing the documentation images.
"""

import argparse
import os
import random
import runpy
import subprocess
import sys
import tempfile
import zipfile
from collections import deque
from pathlib import Path

from PIL import Image

ROOT = Path(__file__).resolve().parents[1]
APPS = ROOT / "python" / "pyxel" / "examples" / "apps"
IMAGES = ROOT / "docs" / "images"
SETTINGS = {
    "30sec_of_daylight": (176, 2, 100, 94),
    "megaball": (650, 2, 33, 0),
}
# Brief held movements alternate with cautious single-tile taps.
DAYLIGHT_STEP_DELAYS = (1, 1, 3, 3, 4, 2, 2, 3, 4, 2, 1, 1, 3, 3, 4, 2, 3, 4)


def path_between(game_map, start, target):
    queue = deque([start])
    previous = {start: None}
    while queue:
        x, y = queue.popleft()
        for dx, dy in ((0, -1), (1, 0), (0, 1), (-1, 0)):
            next_pos = (x + dx, y + dy)
            if (
                next_pos in previous
                or not 0 <= next_pos[0] < game_map.tm_w
                or not 0 <= next_pos[1] < game_map.tm_h
                or game_map._is_tile_solid(*next_pos)
            ):
                continue
            previous[next_pos] = (x, y)
            if next_pos == target:
                path = [target]
                while path[-1] != start:
                    path.append(previous[path[-1]])
                return list(reversed(path))[1:]
            queue.append(next_pos)
    raise ValueError(f"No route from {start} to {target}")


def input_for_frame(name, frame, app, pyxel, controls):
    keys = set()
    if name == "30sec_of_daylight":
        game_map = app.game.world.current_map
        player = game_map.player
        if "path" not in controls:
            start = (player.tile_x, player.tile_y)
            controls["path"] = []
            for target in (
                (7, 6),
                (5, 6),
                (5, 7),
                (6, 7),
                (5, 12),
                (3, 12),
                (3, 6),
                (5, 6),
                (6, 11),
                (6, 6),
                (9, 6),
                (9, 12),
                (11, 13),
                (13, 13),
                (14, 12),
            ):
                controls["path"].extend(path_between(game_map, start, target))
                start = target
            controls["path_index"] = 0
            controls["next_move_frame"] = 1
        position = (player.tile_x, player.tile_y)
        while (
            controls["path_index"] < len(controls["path"])
            and controls["path"][controls["path_index"]] == position
        ):
            controls["path_index"] += 1
        item = game_map.tile_get_any_item(*position)
        if item and item.type == item.TYPE_WEAPON and player.weapon == "None":
            controls["next_move_frame"] = frame + 2
            return {pyxel.KEY_X}
        if frame >= controls["next_move_frame"] and controls["path_index"] < len(
            controls["path"]
        ):
            next_pos = controls["path"][controls["path_index"]]
            direction = next_pos[0] - position[0], next_pos[1] - position[1]
            direction_keys = {
                (0, -1): pyxel.KEY_UP,
                (1, 0): pyxel.KEY_RIGHT,
                (0, 1): pyxel.KEY_DOWN,
                (-1, 0): pyxel.KEY_LEFT,
            }
            if game_map.tile_get_any_enemy(*next_pos):
                keys.update((direction_keys[direction], pyxel.KEY_Z))
                controls["next_move_frame"] = frame + 3
            else:
                keys.add(direction_keys[direction])
                controls["next_move_frame"] = (
                    frame
                    + DAYLIGHT_STEP_DELAYS[
                        controls["path_index"] % len(DAYLIGHT_STEP_DELAYS)
                    ]
                )
    else:
        if frame in (86, 120):
            keys.add(pyxel.KEY_RETURN)
        for start, end, key in (
            (181, 240, pyxel.KEY_RIGHT),
            (241, 300, pyxel.KEY_UP),
            (301, 395, pyxel.KEY_LEFT),
            (396, 420, pyxel.KEY_DOWN),
            (400, 420, pyxel.KEY_RIGHT),
            (421, 470, pyxel.KEY_RIGHT),
            (551, 650, pyxel.KEY_RIGHT),
        ):
            if start <= frame <= end:
                keys.add(key)
        if 195 <= frame <= 202:
            keys.add(pyxel.KEY_DOWN)
        if 370 <= frame <= 380:
            keys.add(pyxel.KEY_DOWN)
        if 620 <= frame <= 640:
            keys.add(pyxel.KEY_UP)
        if frame == 460:
            keys.add(pyxel.KEY_Z)
    return keys


def save_gif(frames, destination, duration):
    colors = sorted({color for frame in frames for _, color in frame.getcolors(256)})
    palette = Image.new("P", (1, 1))
    palette.putpalette(
        [channel for color in colors for channel in color]
        + [0] * (768 - 3 * len(colors))
    )
    frames = [
        frame.quantize(palette=palette, dither=Image.Dither.NONE) for frame in frames
    ]
    frames[0].save(
        destination,
        save_all=True,
        append_images=frames[1:],
        duration=duration,
        loop=0,
        disposal=1,
        optimize=True,
    )


def generate(name, destination):
    import pyxel

    total, scale, duration, seed = SETTINGS[name]
    original_init = pyxel.init
    callbacks = {}

    def init_headless(*args, **kwargs):
        cwd = os.getcwd()
        original_init(*args, **{**kwargs, "headless": True, "fps": 1_000_000})
        os.chdir(cwd)
        random.seed(seed)
        pyxel.rseed(seed)
        pyxel.nseed(seed)

    pyxel.init = init_headless
    pyxel.run = lambda update, draw: callbacks.update(update=update, draw=draw)
    pyxel.play = lambda *args, **kwargs: None
    pyxel.playm = lambda *args, **kwargs: None
    pyxel.stop = lambda *args, **kwargs: None

    with tempfile.TemporaryDirectory() as temp_dir:
        with zipfile.ZipFile(APPS / f"{name}.pyxapp") as archive:
            archive.extractall(temp_dir)
        if name == "30sec_of_daylight":
            source = Path(temp_dir) / "30SecondsOfDaylight" / "src"
        else:
            source = Path(temp_dir) / "megaball" / "megaball"
        os.chdir(source)
        sys.path.insert(0, str(source))
        runpy.run_path(str(source / "main.py"), run_name="__main__")
        app = callbacks["update"].__self__
        if name == "30sec_of_daylight":
            app.game.new_game()
            app.game.world.daylight_control.sec_cnt = 18

        frames = []
        held_keys = set()
        controls = {}
        shot = Path(temp_dir) / "frame.png"
        if name == "30sec_of_daylight":
            callbacks["draw"]()
            pyxel.flip()
            pyxel.screenshot(str(shot), scale=scale)
            with Image.open(shot) as image:
                frames.append(image.convert("RGB"))
            # Hold the opening pose without changing the seeded combat sequence.
            frames.extend([frames[0]] * 6)
        for frame in range(1, total - len(frames) + 1):
            keys = input_for_frame(name, frame, app, pyxel, controls)
            for key in held_keys - keys:
                pyxel.set_btn(key, False)
            for key in keys - held_keys:
                pyxel.set_btn(key, True)
            held_keys = keys
            callbacks["update"]()
            callbacks["draw"]()
            pyxel.flip()
            if name != "megaball" or (frame > total - 600 and frame % 2 == 0):
                pyxel.screenshot(str(shot), scale=scale)
                with Image.open(shot) as image:
                    frames.append(image.convert("RGB"))
        if name == "30sec_of_daylight":
            assert app.game.world.current_map.player.hp == 0
            assert app.game.world.current_map.player.weapon == "Club"
        else:
            assert all(target.is_hit for target in app.game.stage.lights[:2])
        if name == "megaball":
            # The app runs at 60 FPS: keep its final ten seconds at 30 FPS.
            duration = [30, 30, 40] * (len(frames) // 3)
        save_gif(frames, destination, duration)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("apps", nargs="*", choices=tuple(SETTINGS))
    parser.add_argument("--output-dir", type=Path, default=IMAGES)
    parser.add_argument("--worker", choices=tuple(SETTINGS), help=argparse.SUPPRESS)
    args = parser.parse_args()
    args.output_dir = args.output_dir.resolve()
    if args.worker:
        generate(args.worker, args.output_dir / f"{args.worker}.gif")
        return

    names = args.apps or list(SETTINGS)
    args.output_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=args.output_dir) as temp_dir:
        for name in names:
            subprocess.run(
                [
                    sys.executable,
                    str(Path(__file__).resolve()),
                    "--worker",
                    name,
                    "--output-dir",
                    temp_dir,
                ],
                check=True,
                timeout=120,
            )
        for name in names:
            filename = f"{name}.gif"
            os.replace(Path(temp_dir) / filename, args.output_dir / filename)
            print(f"Generated {filename}")


if __name__ == "__main__":
    main()
