#!/usr/bin/env python3

import argparse
import io
import os
import re
import socket
import sys
import threading
import webbrowser
from functools import partial
from http.client import HTTPException, HTTPSConnection
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote, urlparse, urlsplit

ROOT_DIR = Path(__file__).resolve().parent.parent
PUBLIC_ROOT_DIRS = (
    ROOT_DIR / "docs" / "images",
    ROOT_DIR / "web" / "api-reference",
    ROOT_DIR / "web" / "code-maker",
    ROOT_DIR / "web" / "editor-manual",
    ROOT_DIR / "web" / "launcher",
    ROOT_DIR / "web" / "mml-studio",
    ROOT_DIR / "web" / "showcase",
    ROOT_DIR / "web" / "user-guide",
    ROOT_DIR / "web" / "web-usage",
    ROOT_DIR / "wasm",
    ROOT_DIR / "python" / "pyxel" / "examples",
)
PORT = 8000
CDN_RUNTIME_URL = "https://cdn.jsdelivr.net/gh/kitao/pyxel/wasm/pyxel.js"
LOCAL_RUNTIME_URL = "/wasm/pyxel.js"
SOURCE_PREFIX = "/pyxel/launcher/source/"

SW_PATH = "/pyxel-sw.js"
SW_JS = r"""// Pyxel Showcase service worker
self.addEventListener('install', (event) => {
  self.skipWaiting();
});

self.addEventListener('activate', (event) => {
  event.waitUntil(self.clients.claim());
});

self.addEventListener('fetch', (event) => {
  const url = new URL(event.request.url);
  if (url.origin === 'https://cdn.jsdelivr.net' && url.pathname.startsWith('/gh/kitao/pyxel/wasm/')) {
    const suffix = url.pathname.replace('/gh/kitao/pyxel/wasm/', '');
    const localUrl = '/wasm/' + suffix;
    event.respondWith(fetch(localUrl, { cache: 'no-store' }));
    return;
  }
});
"""

INJECT_SNIPPET = """
<script>
(async function() {
  try {
    const isLocalhost = location.hostname === 'localhost' || location.hostname === '127.0.0.1';
    const isSecure = window.isSecureContext || isLocalhost;
    if (!isSecure || !('serviceWorker' in navigator)) return;
    await navigator.serviceWorker.register('__SW_PATH__', { scope: '/' });
  } catch (e) {
    console.warn('SW register failed', e);
  }
})();
</script>
""".replace("__SW_PATH__", SW_PATH)


class Handler(SimpleHTTPRequestHandler):
    def __init__(self, *args, wheel=None, **kwargs):
        self.wheel = wheel
        super().__init__(*args, directory=str(ROOT_DIR), **kwargs)

    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def list_directory(self, path):
        self.send_error(404, "File not found")

    def do_GET(self):
        if self.path.startswith(SOURCE_PREFIX):
            self._serve_launcher_source()
            return
        if self.path == SW_PATH:
            self.send_response(200)
            self.send_header("Content-Type", "application/javascript; charset=utf-8")
            self.end_headers()
            self.wfile.write(SW_JS.encode("utf-8"))
            return
        return super().do_GET()

    def _serve_launcher_source(self):
        path = urlsplit(self.path).path[len(SOURCE_PREFIX) :]
        try:
            decoded = unquote(path, errors="strict")
        except UnicodeError:
            self.send_error(404)
            return
        if (
            not path.isascii()
            or not re.fullmatch(
                r"[\w.-]+/[\w.-]+(?:@[^/]+)?/.*\.py", path, re.IGNORECASE | re.ASCII
            )
            or re.search(r"%(?![0-9a-fA-F]{2})", path)
            or re.search(r"(?:^|/)\.{1,2}(?:/|$)|\x00", decoded)
        ):
            self.send_error(404)
            return
        connection = HTTPSConnection("cdn.jsdelivr.net", timeout=15)
        try:
            connection.request("GET", "/gh/" + path)
            response = connection.getresponse()
            if response.status != 200:
                self.send_error(404 if response.status == 404 else 502)
                return
            data = response.read()
        except (HTTPException, OSError):
            self.send_error(502)
            return
        finally:
            connection.close()
        self.send_response(200)
        self.send_header("Content-Type", "application/octet-stream")
        self.send_header("Content-Length", str(1 + len(data)))
        self.send_header("Content-Security-Policy", "default-src 'none'; sandbox")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Pyxel-Source", "1")
        self.end_headers()
        self.wfile.write(b"\x00")
        self.wfile.write(data)

    def send_head(self):
        parsed = urlparse(self.path)
        path = parsed.path
        if self.wheel is not None and path == f"/wasm/{self.wheel.name}":
            if self.wheel.resolve() != self.wheel or not self.wheel.is_file():
                self.send_error(404, "File not found")
                return None
            try:
                stream = self.wheel.open("rb")
            except OSError:
                self.send_error(404, "File not found")
                return None
            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream")
            self.send_header("Content-Length", str(os.fstat(stream.fileno()).st_size))
            self.end_headers()
            return stream

        full_path = Path(self.translate_path(path)).resolve()
        if not _is_public_path(full_path):
            self.send_error(404, "File not found")
            return None

        if full_path.is_dir():
            for index_name in ("index.html", "index.htm"):
                index_path = full_path / index_name
                if index_path.is_file():
                    if not _is_public_path(index_path.resolve()):
                        self.send_error(404, "File not found")
                        return None
                    if path.endswith("/") and index_name == "index.html":
                        full_path = index_path
                    break

        local_runtime = full_path == ROOT_DIR / "wasm" / "pyxel.js"
        if local_runtime or full_path.suffix == ".html":
            if not full_path.is_file():
                return super().send_head()
            try:
                text = full_path.read_text(encoding="utf-8")
            except (OSError, UnicodeDecodeError):
                return super().send_head()

            if local_runtime:
                # The pinned Pyodide release may not be on kitao.dev yet.
                text = re.sub(
                    r"https://kitao\.dev/pyxel/pyodide/(v[^/\s`]+)/pyodide\.js",
                    r"https://cdn.jsdelivr.net/pyodide/\1/full/pyodide.js",
                    text,
                )
                if self.wheel is not None:
                    text, count = re.subn(
                        r'(?m)^(const PYXEL_WHEEL_PATH\s*=\s*")[^"]+(";)$',
                        rf"\g<1>{self.wheel.name}\2",
                        text,
                    )
                    if count != 1:
                        self.send_error(
                            500, "Expected one PYXEL_WHEEL_PATH in pyxel.js"
                        )
                        return None
                content_type = "text/javascript"
            else:
                text = _inject_html(text)
                content_type = "text/html"
            encoded = text.encode("utf-8")

            self.send_response(200)
            self.send_header("Content-Type", f"{content_type}; charset=utf-8")
            self.send_header("Content-Length", str(len(encoded)))
            self.end_headers()
            return io.BytesIO(encoded)

        return super().send_head()


def main(argv=None) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--wheel", type=Path, help="serve a development WASM wheel from dist/"
    )
    args = parser.parse_args(argv)
    wheel = args.wheel.resolve() if args.wheel is not None else None
    if wheel is not None and not (
        wheel.parent == ROOT_DIR / "dist"
        and re.fullmatch(r"pyxel-[\w.+-]+_wasm32\.whl", wheel.name, re.ASCII)
        and wheel.is_file()
    ):
        parser.error("--wheel requires a Pyxel WASM wheel in dist/")

    ip = _get_ip()
    print(f"Serving HTTP on {ip} port {PORT} (http://{ip}:{PORT}/) ...")
    server = ThreadingHTTPServer(("", PORT), partial(Handler, wheel=wheel))
    threading.Timer(
        0.5, lambda: webbrowser.open(f"http://{ip}:{PORT}/web/showcase/")
    ).start()

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def _get_ip() -> str:
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.connect(("8.8.8.8", 80))
            return sock.getsockname()[0]
    except OSError:
        return "127.0.0.1"


def _is_public_path(path: Path) -> bool:
    if not path.is_relative_to(ROOT_DIR):
        return False
    relative = path.relative_to(ROOT_DIR)
    if any(part.startswith(".") or part == "__pycache__" for part in relative.parts):
        return False
    if relative.parent == Path("docs") and (
        relative.suffix == ".md" or relative.name == "pyxel.gpl"
    ):
        return True
    if relative.as_posix() in {
        "web",
        "web/index.html",
        "web/shared.js",
        "web/styles.css",
    }:
        return True
    return any(
        path == root_dir or path.is_relative_to(root_dir)
        for root_dir in PUBLIC_ROOT_DIRS
    )


def _inject_html(text: str) -> str:
    text = text.replace("https://kitao.dev" + SOURCE_PREFIX, SOURCE_PREFIX)
    lower = text.lower()
    head_idx = lower.rfind("</head>")
    if head_idx != -1:
        text = (
            text[:head_idx].replace(CDN_RUNTIME_URL, LOCAL_RUNTIME_URL)
            + text[head_idx:]
        )
        lower = text.lower()
        head_idx = lower.rfind("</head>")

    if "serviceworker" in lower or "service-worker" in lower:
        return text
    if head_idx != -1:
        return text[:head_idx] + INJECT_SNIPPET + text[head_idx:]
    body_idx = lower.rfind("</body>")
    if body_idx != -1:
        return text[:body_idx] + INJECT_SNIPPET + text[body_idx:]
    return text + INJECT_SNIPPET


if __name__ == "__main__":
    sys.exit(main())
