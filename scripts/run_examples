#!/usr/bin/env bash

set -euo pipefail
shopt -s failglob

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
EXAMPLES_DIR="$ROOT_DIR/python/pyxel/examples"

export PYTHONUNBUFFERED=1

BG_PID=0

cleanup() {
    if [[ "$BG_PID" -ne 0 ]]; then
        kill "$BG_PID" 2>/dev/null || true
        wait "$BG_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT

# Display commands with basenames for readability.
echo_cmd() {
    local display=()
    for arg in "$@"; do
        display+=("${arg##*/}")
    done
    echo "${display[*]}"
}

# Echo and run a GUI command in the background; Ctrl+C sends SIGTERM.
run_bg() {
    echo_cmd "$@"
    "$@" &
    BG_PID=$!
    trap 'kill "$BG_PID" 2>/dev/null; exit 130' INT
    local status
    if wait "$BG_PID"; then
        status=0
    else
        status=$?
    fi
    trap - INT
    BG_PID=0
    return "$status"
}

for f in "$EXAMPLES_DIR"/*.py "$EXAMPLES_DIR"/cube/c[0-9][0-9]_*.py; do
    run_bg pyxel run "$f"
done

for f in "$EXAMPLES_DIR"/apps/*.pyxapp; do
    run_bg pyxel play "$f"
done

run_bg pyxel edit "$EXAMPLES_DIR/assets/sample.pyxres"
