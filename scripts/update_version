#!/usr/bin/env python3

import re
import sys
import zipfile
from email.parser import Parser
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
SETTINGS_PATH = "crates/pyxel-core/src/settings.rs"
CARGO_PATH = "crates/Cargo.toml"
PROJECT_PATH = "python/pyproject.toml"
MANIFEST_TABLES = {PROJECT_PATH: "[project]", CARGO_PATH: "[workspace.package]"}
SETTINGS_VERSION = re.compile(r'(?m)^pub const VERSION: &str = "([^"\n]+)";$')
MANIFEST_VERSION = re.compile(r'(?m)^version = "([^"\n]+)"')
WASM_WHEEL_PATH = re.compile(r'(?m)^const PYXEL_WHEEL_PATH\s*=\s*"([^"\n]+)";$')
EXPECTED_WHEEL_TAG = "cp311-abi3-pyemscripten_2026_0_wasm32"
PRE_RELEASE_MAP = {"a": "alpha", "b": "beta", "rc": "rc"}


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv and argv[0] in ("--check", "--check-build"):
        if len(argv) > 2:
            print(f"Usage: update_version {argv[0]} [v<version>]", file=sys.stderr)
            return 1
        try:
            errors = version_errors(
                tag=argv[1] if len(argv) == 2 else None,
                build_only=argv[0] == "--check-build",
            )
        except ValueError as error:
            print(f"error: {error}", file=sys.stderr)
            return 1
        if errors:
            for error in errors:
                print(f"error: {error}", file=sys.stderr)
            return 1

        print("Version surfaces are consistent")
        return 0

    if len(argv) != 1:
        print("Usage: update_version <version>", file=sys.stderr)
        return 1
    try:
        update_version(argv[0])
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1
    return 0


def update_version(version: str, root_dir: Path = ROOT_DIR) -> None:
    cargo_version = pep440_to_semver(version)
    updates = []
    for relative_path in (SETTINGS_PATH, *MANIFEST_TABLES):
        path = root_dir / relative_path
        text = path.read_text(encoding="utf-8")
        field = _version_field(relative_path, text)
        value = cargo_version if relative_path == CARGO_PATH else version
        updates.append((path, text[: field.start(1)] + value + text[field.end(1) :]))

    for path, text in updates:
        path.write_text(text, encoding="utf-8")


def version_errors(
    root_dir: Path = ROOT_DIR, tag: str | None = None, *, build_only: bool = False
) -> list[str]:
    if tag is not None:
        tag = tag.removeprefix("refs/tags/")
        if not tag.startswith("v") or len(tag) == 1:
            return [f"tag: expected v<version>, found {tag}"]

    versions = {
        path: _version_field(path, (root_dir / path).read_text(encoding="utf-8"))[1]
        for path in (SETTINGS_PATH, *MANIFEST_TABLES)
    }
    expected = tag[1:] if tag is not None else versions[SETTINGS_PATH]
    errors = []
    for relative_path, actual in versions.items():
        surface_expected = (
            pep440_to_semver(expected) if relative_path == CARGO_PATH else expected
        )
        if actual != surface_expected:
            errors.append(
                f"{relative_path}: expected {surface_expected}, found {actual}"
            )

    if build_only:
        return errors

    runtime = (root_dir / "wasm/pyxel.js").read_text(encoding="utf-8")
    reference = WASM_WHEEL_PATH.search(runtime)
    if reference is None:
        raise ValueError("wheel path not found in wasm/pyxel.js")
    wheel_name = reference[1]
    match = re.fullmatch(rf"pyxel-([a-z0-9.+]+)-{EXPECTED_WHEEL_TAG}\.whl", wheel_name)
    if match is None:
        expected_wheel_name = f"pyxel-{expected}-{EXPECTED_WHEEL_TAG}.whl"
        errors.append(
            f"wasm/pyxel.js: expected wheel {expected_wheel_name}, found {wheel_name}"
        )
    else:
        wasm_version = match.group(1)
        if wasm_version != expected:
            errors.append(f"wasm/pyxel.js: expected {expected}, found {wasm_version}")
        wheel_path = root_dir / "wasm" / wheel_name
        if wheel_path.is_file():
            errors.extend(_wheel_tag_errors(wheel_path, wasm_version))
        else:
            errors.append(
                f"wasm/pyxel.js: referenced wheel not found: wasm/{wheel_name}"
            )

    wheel_paths = sorted((root_dir / "wasm").glob("pyxel-*.whl"))
    if len(wheel_paths) != 1:
        wheel_names = ", ".join(path.name for path in wheel_paths)
        errors.append(
            "wasm: expected exactly one Pyxel wheel, "
            f"found {len(wheel_paths)}: {wheel_names or 'none'}"
        )

    return errors


def pep440_to_semver(version: str) -> str:
    part = r"(?:0|[1-9][0-9]*)"
    match = re.fullmatch(
        rf"({part})\.({part})\.({part})(?:(a|b|rc)({part})|\+([a-z0-9]+(?:\.[a-z0-9]+)*))?",
        version,
    )
    if match is None:
        raise ValueError(f"invalid release version: {version!r}")

    major, minor, patch, tag, number, local = match.groups()
    # Cargo and the wheel builder store numeric release components as u64.
    maximum = "18446744073709551615"
    for value in (major, minor, patch, number):
        if value is not None and (len(value), value) > (len(maximum), maximum):
            raise ValueError(f"invalid release version: {version!r}")
    # Wheel filenames normalize purely numeric local parts such as 01 to 1.
    if local and any(
        len(label) > 1 and label.startswith("0") and label.isdecimal()
        for label in local.split(".")
    ):
        raise ValueError(f"invalid release version: {version!r}")
    if tag:
        return f"{major}.{minor}.{patch}-{PRE_RELEASE_MAP[tag]}.{number}"
    return version


def _version_field(relative_path: str, text: str) -> re.Match:
    if relative_path == SETTINGS_PATH:
        match = SETTINGS_VERSION.search(text)
    else:
        # A dependency or tool table can declare its own version.
        table = re.escape(MANIFEST_TABLES[relative_path])
        header = re.search(rf"(?m)^{table}[ \t]*(?:#.*)?$", text)
        match = None
        if header:
            next_table = text.find("\n[", header.end())
            end = len(text) if next_table == -1 else next_table
            match = MANIFEST_VERSION.search(text, header.end(), end)
    if match is None:
        raise ValueError(f"version pattern not found in {relative_path}")
    return match


def _wheel_tag_errors(wheel_path: Path, version: str) -> list[str]:
    wheel_metadata_name = f"pyxel-{version}.dist-info/WHEEL"
    try:
        with zipfile.ZipFile(wheel_path) as wheel_zip:
            if wheel_zip.namelist().count(wheel_metadata_name) != 1:
                return [
                    (
                        f"wasm/{wheel_path.name}: expected wheel metadata member "
                        f"{wheel_metadata_name}"
                    )
                ]
            wheel_metadata = Parser().parsestr(
                wheel_zip.read(wheel_metadata_name).decode("utf-8", errors="strict")
            )
    except (OSError, UnicodeDecodeError, zipfile.BadZipFile) as error:
        return [f"wasm/{wheel_path.name}: invalid wheel: {error}"]

    if wheel_metadata.get_all("Tag", []) != [EXPECTED_WHEEL_TAG]:
        return [
            (
                f"wasm/{wheel_path.name}: WHEEL Tag fields do not match "
                f"{EXPECTED_WHEEL_TAG}"
            )
        ]
    return []


if __name__ == "__main__":
    raise SystemExit(main())
