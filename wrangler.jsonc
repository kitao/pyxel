{
  "name": "pyxel",
  "compatibility_date": "2026-10-14",
  "workers_dev": false,
  "preview_urls": false,
  // The zone's "Pyxel trailing slash" Redirect Rule also handles root queries:
  // http.host eq "kitao.dev" and http.request.uri.path eq "/pyxel"
  // -> 308 https://kitao.dev/pyxel/ with the query string preserved.
  "routes": [
    { "pattern": "kitao.dev/pyxel", "zone_name": "kitao.dev" },
    { "pattern": "kitao.dev/pyxel/*", "zone_name": "kitao.dev" },
  ],
  "assets": {
    "directory": "./dist/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
