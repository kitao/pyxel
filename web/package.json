{
  "private": true,
  "scripts": {
    "dev": "node scripts/wrangler.mjs dev --port 4186",
    "test": "node --test tests/*.test.js tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "npm test && npm run test:browser",
    "deploy:check": "npm run check && node scripts/wrangler.mjs deploy --dry-run",
    "deploy": "npm run deploy:check && node scripts/wrangler.mjs deploy --strict"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.4",
    "axe-core": "4.14.0",
    "prettier": "^3.9.10",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
