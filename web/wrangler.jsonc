{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pyxel",
  "compatibility_date": "2026-10-06",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "kitao.dev/pyxel*", "zone_name": "kitao.dev" }],
  "assets": { "directory": "../dist/site" },
  "build": {
    "command": "python3 ../scripts/build_site",
    "watch_dir": [
      "index.html",
      "shared.js",
      "styles",
      "api-reference",
      "code-maker",
      "editor-manual",
      "launcher",
      "mml-studio",
      "pyodide-files.json",
      "pyodide-NOTICE.txt",
      "showcase",
      "user-guide",
      "web-usage",
      "../docs/images",
      "../docs/pyxel.gpl",
      "../python/pyxel/examples",
      "../wasm",
      "../scripts/build_site",
    ],
  },
}
